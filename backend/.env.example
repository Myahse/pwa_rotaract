APP_ENV=development
HOST=0.0.0.0
PORT=8088
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=24h
INVITE_TTL=168h
PASSWORD_RESET_TTL=1h

# Tombola member import (only needed for cmd/import-tombola)
# TOMBOLA_DATABASE_URL=postgresql://...

APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8088

UPLOAD_DIR=./uploads
MAX_AVATAR_SIZE=5242880

# Full connection string — replace user, password, and database with yours.
# Example: postgresql://postgres:yourpassword@localhost:5432/postgres?sslmode=disable
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/postgres?sslmode=disable

# First admin (created only if no admin exists yet)
BOOTSTRAP_ADMIN_EMAIL=admin@rotaract-civ.local
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Birthday notifications (Web Push + widget)
BIRTHDAY_TIMEZONE=Africa/Abidjan
BIRTHDAY_NOTIFY_HOUR=8
CRON_SECRET=change-me

# Generate with: go run ./cmd/vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rotaract-civ.local

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@rotaract-civ.local
SMTP_FROM_NAME=Rotaract CIV

# Brevo transactional email (preferred when BREVO_API_KEY is configured)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Rotaract CIV

# Examples:
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password

# Google Sign-In for club registration finish — deferred (uncomment when ready)
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
